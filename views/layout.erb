<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>x100 — BSV Wallet</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
</head>
<body class="h-full">
  <nav class="bg-gray-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <div class="flex items-center">
          <span class="text-white font-bold text-lg">x100</span>
          <div class="ml-10 flex items-baseline space-x-4">
            <a href="<%= prefix %>/" class="rounded-md px-3 py-2 text-sm font-medium text-white hover:bg-gray-700">Home</a>
            <% if unlocked? %>
              <a href="<%= prefix %>/legacy" class="rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white">Legacy Payment</a>
              <a href="<%= prefix %>/actions" class="rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white">Transactions</a>
              <a href="<%= prefix %>/settings" class="rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white">Settings</a>
            <% else %>
              <span class="rounded-md px-3 py-2 text-sm font-medium text-gray-500 cursor-not-allowed">Legacy Payment</span>
              <span class="rounded-md px-3 py-2 text-sm font-medium text-gray-500 cursor-not-allowed">Transactions</span>
              <span class="rounded-md px-3 py-2 text-sm font-medium text-gray-500 cursor-not-allowed">Settings</span>
            <% end %>
          </div>
        </div>
        <% if unlocked? %>
          <form method="post" action="<%= prefix %>/lock">
            <button type="submit" class="rounded-md bg-gray-700 px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-600 hover:text-white">Lock</button>
          </form>
        <% end %>
      </div>
    </div>
  </nav>

  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <% if session["flash_error"] %>
      <div class="mb-6 rounded-md bg-red-50 p-4">
        <p class="text-sm text-red-700"><%= session.delete("flash_error") %></p>
      </div>
    <% end %>
    <%= yield %>
  </main>

  <footer class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
    <p class="text-xs text-gray-400">x100-rack v<%= X100::VERSION %></p>
  </footer>
</body>
</html>
