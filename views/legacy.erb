<h2>Legacy Payment</h2>

<article>
  <header><h3>Send</h3></header>
  <form method="post" action="<%= prefix %>/legacy/send">
    <label for="address">Address</label>
    <input type="text" id="address" name="address" placeholder="BSV address (1... or 3...)" required>
    <label for="amount">Amount (sats)</label>
    <input type="number" id="amount" name="amount" min="1" placeholder="Amount in satoshis" required>
    <button type="submit">Send</button>
  </form>
</article>

<article>
  <header><h3>Receive</h3></header>
  <dl>
    <dt>Identity Key</dt>
    <dd><code><%= wallet_manager.identity_key %></code></dd>
  </dl>
</article>
