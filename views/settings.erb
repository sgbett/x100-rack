<h2>Settings</h2>

<article>
  <header><h3>Session Timeout</h3></header>
  <form method="post" action="/settings">
    <label for="timeout">Auto-lock after (minutes)</label>
    <input type="number" id="timeout" name="timeout" min="1" max="1440"
           value="<%= session_timeout / 60 %>">
    <button type="submit">Save</button>
  </form>
</article>
