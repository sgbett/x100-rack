<h2 class="text-2xl font-bold text-gray-900 mb-6">Settings</h2>

<div class="mx-auto max-w-md">
  <div class="rounded-lg bg-white p-6 shadow">
    <h3 class="text-sm font-medium text-gray-500 mb-4">Session Timeout</h3>
    <form method="post" action="<%= prefix %>/settings" class="space-y-4">
      <div>
        <label for="timeout" class="block text-sm font-medium text-gray-700">Auto-lock after (minutes)</label>
        <input type="number" id="timeout" name="timeout" min="1" max="1440"
               value="<%= session_timeout / 60 %>"
               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
      </div>
      <button type="submit" class="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">Save</button>
    </form>
  </div>
</div>
