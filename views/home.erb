<% if session["show_wif"] %>
  <div class="mb-8 rounded-lg border border-amber-300 bg-amber-50 p-6">
    <h3 class="text-lg font-semibold text-amber-800">Wallet Created — Save Your Recovery Key</h3>
    <p class="mt-2 text-sm text-amber-700">This is your private key (WIF). Write it down and store it securely. It will not be shown again.</p>
    <pre class="mt-4 rounded-md bg-gray-900 p-4 text-sm text-green-400 overflow-x-auto"><code><%= session.delete("show_wif") %></code></pre>
    <p class="mt-4 text-sm font-semibold text-red-600">If you lose this key and your password, your funds are unrecoverable.</p>
  </div>
<% end %>

<% if unlocked? %>
  <h2 class="text-2xl font-bold text-gray-900 mb-6">Wallet</h2>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="rounded-lg bg-white p-6 shadow">

      <h3 class="text-sm font-medium text-gray-500">Balance</h3>
      <p class="mt-2 text-3xl font-semibold text-gray-900"><%= wallet_manager.balance %> <span class="text-lg text-gray-500">sats</span></p>

      <h3 class="text-sm font-medium text-gray-500 mt-4">Identity Key</h3>
      <p class="mt-2 font-mono text-sm text-gray-900 break-all"><%= wallet_manager.identity_key %></p>

    </div>

    <div class="rounded-lg bg-white p-6 shadow">
      <nav class="flex space-x-1 mb-4" aria-label="Tabs">
        <button type="button" data-tab="send"
                class="tab-pill rounded-md px-3 py-2 text-sm font-medium bg-indigo-100 text-indigo-700"
                onclick="switchTab('send')">Send</button>
        <button type="button" data-tab="receive"
                class="tab-pill rounded-md px-3 py-2 text-sm font-medium text-gray-500 hover:text-gray-700 hover:bg-gray-100"
                onclick="switchTab('receive')">Receive</button>
      </nav>

      <div id="tab-send">
        <form method="post" action="<%= prefix %>/send" class="space-y-4">
          <div>
            <label for="recipient" class="block text-sm font-medium text-gray-700">Identity Key</label>
            <input type="text" id="recipient" name="recipient" placeholder="Recipient identity key (hex)" required
                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
          </div>
          <div>
            <label for="amount" class="block text-sm font-medium text-gray-700">Amount (sats)</label>
            <input type="number" id="amount" name="amount" min="1" placeholder="Amount in satoshis" required
                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
          </div>
          <button type="submit" class="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Send</button>
        </form>
      </div>

      <div id="tab-receive" class="hidden">
        <div class="space-y-3">
          <p class="text-sm text-gray-500">BRC-42 derived addresses for receiving payments.</p>
          <div id="receive-addresses" class="space-y-2">
            <p class="text-sm text-gray-400 italic">No addresses generated yet.</p>
          </div>
          <button type="button"
                  hx-post="<%= prefix %>/receive/generate"
                  hx-target="#receive-addresses"
                  hx-swap="beforeend"
                  class="w-full rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
            Generate New Address
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    function switchTab(tab) {
      document.getElementById('tab-send').classList.toggle('hidden', tab !== 'send');
      document.getElementById('tab-receive').classList.toggle('hidden', tab !== 'receive');
      document.querySelectorAll('.tab-pill').forEach(function(btn) {
        if (btn.dataset.tab === tab) {
          btn.className = 'tab-pill rounded-md px-3 py-2 text-sm font-medium bg-indigo-100 text-indigo-700';
        } else {
          btn.className = 'tab-pill rounded-md px-3 py-2 text-sm font-medium text-gray-500 hover:text-gray-700 hover:bg-gray-100';
        }
      });
    }
  </script>

<% elsif wallet_manager.first_run? %>
  <%= render("_setup") %>

<% else %>
  <%= render("_unlock") %>

<% end %>
